APP_NAME=ProofBox AI
APP_ENV=development

# AI provider: "vultr" (Vultr Serverless Inference) or "ollama" (Ollama Cloud)
AI_PROVIDER=vultr
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=

# Used only when AI_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# Sandbox server on Vultr
SANDBOX_HOST=
SANDBOX_USER=sandbox
SANDBOX_KEY_PATH=
SANDBOX_KNOWN_HOSTS_FILE=
